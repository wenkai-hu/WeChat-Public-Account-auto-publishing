{
  "tasks": {
    "preview": "deno run -A --env-file=.env src/cli.ts preview",
    "publish": "deno run -A --env-file=.env src/cli.ts publish",
    "sample": "deno run -A src/cli.ts sample",
    "cover": "deno run -A src/cli.ts cover",
    "rerender": "deno run -A src/cli.ts rerender",
    "check": "deno check src/cli.ts",
    "test": "deno test -A"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true
  }
}
