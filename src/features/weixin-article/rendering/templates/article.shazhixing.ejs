<%
function renderContentBlock(html) {
  return (html || "")
    .replace(/<img\b([^>]*)\/?>/gi, function(_, attrs) {
      attrs = attrs.replace(/\sstyle=(["']).*?\1/gi, "").replace(/\/\s*$/, "");
      return '<img' + attrs + ' style="max-width:100%;display:block;margin:18px auto;border-radius:4px;" />';
    })
    .replace(/<strong>/gi, '<strong style="font-weight:bold;color:#ffffff;background-color:#FF7918;">')
    .replace(/<em>/gi, '<em style="font-style:normal;color:#FFD9B3;">')
    .replace(/<ul>/gi, '<section style="margin:14px 0;padding:0;">')
    .replace(/<\/ul>/gi, '</section>')
    .replace(/<ol>/gi, '<section style="margin:14px 0;padding:0;">')
    .replace(/<\/ol>/gi, '</section>')
    .replace(/<li>/gi, '<p style="margin:8px 0;color:#ffffff;font-size:14px;line-height:2;letter-spacing:0.5px;">▪&nbsp;')
    .replace(/<\/li>/gi, '</p>');
}

// 爬取时间区间：右端=今天，左端=今天 - 数据源保留天数（config sourceLimits.maxAgeDays）
var periodEnd = new Date();
var maxAgeDays = (articles && articles[0] && articles[0].metadata && articles[0].metadata.maxAgeDays) || 5;
var periodStart = new Date(periodEnd.getTime() - maxAgeDays * 86400000);
function fmtDot(d) { return d.getFullYear() + '.' + (d.getMonth() + 1) + '.' + d.getDate(); }
function fmtDotRange(a, b) {
  var bStr = (b.getFullYear() === a.getFullYear() ? '' : b.getFullYear() + '.') + (b.getMonth() + 1) + '.' + b.getDate();
  return fmtDot(a) + '-' + bStr;
}
function fmtCnRange(a, b) {
  var aM = a.getMonth() + 1, aD = a.getDate(), bM = b.getMonth() + 1, bD = b.getDate();
  return aM + '月' + aD + '日-' + (bM === aM ? '' : bM + '月') + bD + '日';
}
var cnWeek = ['一', '二', '三', '四', '五', '六'][Math.floor((periodStart.getDate() - 1) / 7)];
%>
<section style="font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;background-color:#002E39;box-sizing:border-box;font-style:normal;font-weight:400;text-align:justify;color:#3E3E3E;margin:0;padding:0;">

  <section style="background-color:#002E39;margin:0;padding:26px 14px 20px;">
    <section style="text-align:center;margin:0 0 18px;">
      <p style="margin:0 0 12px;color:#ffffff;font-size:18px;font-weight:bold;letter-spacing:1px;line-height:1.4;opacity:0.92;">MT GLOBAL WEEKLY NEWS</p>
      <section style="display:block;width:100%;padding:8px 0;background-color:rgba(255,255,255,0.33);">
        <p style="margin:0;color:#ffffff;font-size:36px;font-weight:bold;letter-spacing:1px;text-align:center;line-height:1.3;">迈途国际资讯汇总</p>
      </section>
    </section>

    <section style="margin:22px 0 6px auto;width:90%;padding:6px 14px;text-align:right;border-left:1px dashed #ffffff;border-right:1px solid #ffffff;letter-spacing:2px;line-height:2;">
      <p style="margin:0;color:#ffffff;font-weight:bold;font-size:16px;letter-spacing:0.5px;"><%= fmtDotRange(periodStart, periodEnd) %></p>
      <p style="margin:0;color:#ffffff;font-weight:bold;font-size:15px;letter-spacing:0.5px;">跨境电商 · 卖家资讯汇编</p>
    </section>
    <p style="margin:0;color:#ffffff;font-size:15px;letter-spacing:0.5px;text-align:right;line-height:1.2;"><b style="font-weight:bold;letter-spacing:0.5px;">-----------------------------------------</b></p>
  </section>

  <section style="background-color:#002E39;margin:0;padding:2px 14px 0;">
    <p style="margin:0 0 12px;color:#ffffff;font-size:15px;letter-spacing:0.5px;line-height:1.9;"><span style="background-color:#FF7918;color:#ffffff;font-weight:bold;padding:0 2px;"><%= periodStart.getFullYear() %>年<%= periodStart.getMonth() + 1 %>月第<%= cnWeek %>周（<%= fmtCnRange(periodStart, periodEnd) %>）</span>，跨境电商领域又产生了哪些重要信息？</p>
    <p style="margin:0 0 16px;color:#ffffff;font-size:15px;letter-spacing:0.5px;line-height:1.9;">以下是我们<span style="background-color:#FF7918;color:#ffffff;font-weight:bold;padding:0 2px;">迈途国际</span>为各位卖家朋友带来的一周资讯汇总：</p>
  </section>

  <section style="background-color:#002E39;margin:0;padding:0 14px 14px;">
    <section style="padding:18px 16px;border:2px solid #ffffff;background-color:#002E39;">
      <p style="margin:0 0 2px;color:#FF7918;font-size:14px;font-weight:bold;letter-spacing:3px;line-height:1.4;">本期资讯目录</p>
      <p style="margin:0 0 14px;color:rgba(255,255,255,0.7);font-size:12px;letter-spacing:2px;line-height:1.4;">CONTENTS</p>
      <% for(var t=0; t<articles.length; t++) { %>
        <p style="margin:0 0 10px;color:#ffffff;font-size:15px;letter-spacing:0.5px;line-height:1.7;"><span style="color:#FF7918;font-weight:bold;"><%= (t + 1).toString().padStart(2, '0') %></span>&nbsp;&nbsp;<%= articles[t].title %></p>
      <% } %>
    </section>
  </section>

  <% for(var j=0; j<articles.length; j++) { var article=articles[j]; %>
    <section style="background-color:#002E39;margin:0;padding:0 0 10px;">
      <section style="display:flex;flex-flow:row;background-color:#FF7918;transform:translate3d(38px,0,0);">
        <section style="width:22%;text-align:center;align-self:center;box-sizing:border-box;">
          <p style="margin:0;padding:0;color:#ffffff;font-size:40px;font-weight:bold;line-height:1.2;"><%= (j + 1).toString().padStart(2, '0') %></p>
        </section>
        <section style="width:56%;text-align:center;align-self:center;box-sizing:border-box;">
          <p style="margin:0;padding:0 20px;color:#ffffff;font-size:17px;font-weight:bold;letter-spacing:3px;line-height:1.5;">ARTICLE <%= (j + 1).toString().padStart(2, '0') %></p>
        </section>
        <section style="width:22%;text-align:center;align-self:center;box-sizing:border-box;">
          <p style="margin:0;padding:0;color:#ffffff;font-size:22px;font-weight:bold;line-height:1.2;">✦</p>
        </section>
      </section>
      <section style="margin:0;padding:20px 14px 24px;border:2px solid #ffffff;background-color:#002E39;">
        <p style="margin:0 0 18px;color:#ffffff;font-size:19px;font-weight:bold;letter-spacing:1px;line-height:1.5;"><%= article.title %></p>
        <% var content=article.content || ""; var paragraphs=content.split("<next_paragraph />");
        for(var i=0; i<paragraphs.length; i++) { var para=paragraphs[i].trim(); if(para.length>0) { %>
          <section style="margin:0 0 16px;color:#ffffff;font-size:14px;letter-spacing:0.5px;line-height:2;text-align:justify;">
            <%- renderContentBlock(para) %>
          </section>
        <% }} %>
        <% if (article.media && article.media.length > 0) { %>
          <section style="margin:18px 0;text-align:center;">
            <img src="<%= article.media[0].url %>" style="max-width:100%;width:100%;height:auto;display:block;margin:0 auto;border-radius:4px;" />
          </section>
        <% } %>
        <% if (article.url) { %>
          <section style="margin:18px 0 0;padding:10px 12px;border:1px solid rgba(255,255,255,0.5);font-size:13px;color:rgba(255,255,255,0.9);word-break:break-all;line-height:1.8;">
            原文链接：<a href="<%= article.url %>" style="color:#FFB366;text-decoration:none;"><%= article.url %></a>
          </section>
        <% } %>
      </section>
    </section>
    <% if (j < articles.length - 1) { %>
      <p style="background-color:#002E39;margin:0;padding:24px 14px;color:rgba(255,255,255,0.6);font-size:15px;letter-spacing:0.5px;text-align:center;line-height:1.2;"><b style="font-weight:bold;letter-spacing:0.5px;">-----------------------------------------</b></p>
    <% } %>
  <% } %>

  <!-- 关于迈途国际 -->
  <section style="background-color:#002E39;margin:0;padding:0 14px 14px;">
    <section style="padding:18px 14px;border:2px solid #ffffff;background-color:#002E39;">
      <p style="margin:0 0 2px;color:#FF7918;font-size:14px;font-weight:bold;letter-spacing:3px;line-height:1.4;">关于迈途国际</p>
      <p style="margin:0 0 14px;color:rgba(255,255,255,0.7);font-size:12px;letter-spacing:2px;line-height:1.4;">ABOUT MT GLOBAL</p>
      <img src="https://mmbiz.qpic.cn/sz_mmbiz_png/0ibUxoKuTmtZusj6JGDrOXsHy0HH0Fl8WdCwbfjjg5Eonprk2YCSJhZgo2R8FFwsG09U7GQRM4uicotOSDol2gibTTYsKWXDvtVDiaF0MvGXQsg/640?wx_fmt=png&amp;from=appmsg" style="width:100%;height:auto;display:block;margin:0 0 16px;border-radius:4px;" />
      <p style="margin:0 0 12px;color:#ffffff;font-size:14px;letter-spacing:0.5px;line-height:2;text-align:justify;">迈途国际商务（MT Global）是一家为国内中小企业提供出海服务的机构，以香港公司注册及商务秘书服务为基础，开拓欧美日、东南亚、南美等国家的公司注册、银行开户、年审审计、知识产权、ODI备案，FDI备案，企业出海咨询等服务，拥有数十名资深企业顾问和专业会计师团队，立足国内，辐射全球，让生意无国界，让创业更简单！</p>
      <p style="margin:0;color:#ffffff;font-size:14px;letter-spacing:0.5px;line-height:2;text-align:justify;">迈途深耕出海服务10年，专业团队实时更新与您切身相关的资讯，帮助企业解决全球出海和跨境运营的烦恼，防范各阶段的风险，提供稳定境外架构搭建，合规手续办理服务。我们一直以来致力于为您提供更专业、更高效、更可靠的服务，为您带来更有价值的商务服务体验。</p>
    </section>
  </section>

  <!-- 联系客服 -->
  <section style="background-color:#002E39;margin:0;padding:0 14px 24px;">
    <section style="padding:18px 14px;border:2px solid #FF7918;text-align:center;">
      <p style="margin:0 0 14px;color:#ffffff;font-size:15px;letter-spacing:1px;line-height:2;">如需了解更多出海资讯，欢迎联系我们迈途国际客服，扫描下方二维码添加好友</p>
      <img src="https://mmbiz.qpic.cn/mmbiz_png/0ibUxoKuTmtYGSDk80X7MlwssTaee3WibUu2FXk9iaHicnfqLQaXGsWDsiaXhxI1B5VNk16bQO8U4knH3dDBdhVibgnVbIPpicEjVP03oFP6leImLI/640?wx_fmt=png&amp;from=appmsg" style="width:180px;height:auto;display:block;margin:0 auto;border-radius:4px;" />
    </section>
  </section>

  <p style="background-color:#002E39;margin:0;padding:26px 14px 16px;color:rgba(255,255,255,0.6);font-size:15px;letter-spacing:0.5px;text-align:right;line-height:1.2;"><b style="font-weight:bold;letter-spacing:0.5px;">-----------------------------------------</b></p>
  <section style="background-color:#002E39;margin:0;padding:0 14px 24px;">
    <section style="padding:18px 14px;border:2px solid #ffffff;text-align:center;">
      <p style="margin:0;color:#ffffff;font-size:14px;letter-spacing:1px;line-height:2;">如果你觉得内容不错，欢迎分享转发<br/><span style="color:rgba(255,255,255,0.8);font-size:12px;letter-spacing:0.5px;">本内容仅供参考，不构成业务建议</span></p>
    </section>
  </section>
</section>
